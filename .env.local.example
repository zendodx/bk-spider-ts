# 数据库配置（可选，未设置时使用默认值）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=bk_spider

# 数据目录（可选）
DATA_DIR=/Users/yourname/bk_spider_data/采集数据
RESOURCES_DIR=/Users/yourname/bk_spider_data/resources

# AI 验证码自动求解（可选，配置后遇到极验验证码会先由 AI 尝试，失败回退人工）
# 阿里云百炼 DashScope API Key：https://bailian.console.aliyun.com/
QWEN_API_KEY=sk-your-dashscope-api-key
# 视觉模型与接口地址（一般无需修改）
QWEN_VL_MODEL=qwen-vl-max-latest
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
