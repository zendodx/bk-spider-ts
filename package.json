{
  "name": "bk-spider",
  "version": "1.0.0",
  "description": "贝壳找房爬虫桌面应用 - Electron + Next.js + Playwright",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run rebuild:system && concurrently \"npm run next:dev\" \"npm run electron:dev\"",
    "next:dev": "next dev -p 3799",
    "next:build": "next build",
    "electron:dev": "wait-on http://localhost:3799 && electron .",
    "electron:build": "npm run next:build && electron-builder && npm run rebuild:system",
    "build": "npm run next:build && electron-builder && npm run rebuild:system",
    "build:mac": "npm run next:build && electron-builder --mac && npm run rebuild:system",
    "build:win": "npm run next:build && electron-builder --win && npm run rebuild:system",
    "rebuild:system": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-builder install-app-deps",
    "postinstall": "echo 'skip auto rebuild - use npm run rebuild:system for dev mode'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@react-pdf/renderer": "^4.4.0",
    "better-sqlite3": "^12.8.0",
    "electron-log": "^5.1.5",
    "electron-store": "^8.2.0",
    "exceljs": "^4.4.0",
    "next": "^14.2.3",
    "playwright": "^1.44.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.0.2",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.bkspider.app",
    "productName": "贝壳找房爬虫",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "package.json",
      "next.config.js",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/playwright/.local-browsers/**/*",
      "!node_modules/playwright-core/.local-browsers/**/*",
      "!**/*.map",
      "!src/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "app/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "app/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "scripts/after-install.js",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    }
  }
}
